/* ==========================================
   Douglas Electric Equipment Portal
========================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:'Inter',sans-serif;
    background:#f5f7fa;
    color:#222;
    line-height:1.6;
}

header{
    background:#0a8a43;
    color:white;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:18px 8%;
    flex-wrap:wrap;
    box-shadow:0 4px 12px rgba(0,0,0,.15);
}

.logo-area{
    display:flex;
    align-items:center;
    gap:18px;
}

.logo{
    width:70px;
    height:70px;
    object-fit:contain;
}

header h1{
    font-size:28px;
}

header p{
    opacity:.9;
    font-size:14px;
}

nav{
    display:flex;
    gap:20px;
    flex-wrap:wrap;
}

nav a{
    color:white;
    text-decoration:none;
    font-weight:600;
    transition:.25s;
}

nav a:hover{
    color:#d6ffd9;
}

.hero{
    background:linear-gradient(135deg,#0a8a43,#0fbd5c);
    color:white;
    text-align:center;
    padding:90px 20px;
}

.hero h2{
    font-size:48px;
    margin-bottom:20px;
}

.hero p{
    max-width:850px;
    margin:auto;
    font-size:19px;
}

.hero input{
    margin-top:35px;
    width:420px;
    max-width:95%;
    padding:16px;
    border:none;
    border-radius:12px;
    font-size:17px;
}

.cards{
    width:90%;
    margin:60px auto;
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:28px;
}

.card{
    background:white;
    border-radius:16px;
    padding:30px;
    text-decoration:none;
    color:#222;
    transition:.25s;
    box-shadow:0 10px 20px rgba(0,0,0,.08);
}

.card:hover{
    transform:translateY(-8px);
    box-shadow:0 15px 30px rgba(0,0,0,.15);
}

.card h3{
    color:#0a8a43;
    margin-bottom:10px;
    font-size:24px;
}

.card p{
    margin-bottom:10px;
}

.future{
    opacity:.65;
}

.about{
    width:90%;
    max-width:1100px;
    margin:80px auto;
    background:white;
    border-radius:16px;
    padding:45px;
    box-shadow:0 10px 20px rgba(0,0,0,.08);
}

.about h2{
    color:#0a8a43;
    margin-bottom:18px;
}

.about p{
    font-size:18px;
}

footer{
    background:#111;
    color:white;
    text-align:center;
    padding:30px;
    margin-top:70px;
}

/* ---------- Equipment Pages ---------- */

.page{
    width:90%;
    max-width:1200px;
    margin:auto;
    padding:50px 0;
}

.banner{
    background:#0a8a43;
    color:white;
    padding:35px;
    border-radius:16px;
    margin-bottom:40px;
}

.banner h2{
    font-size:40px;
}

.section{
    background:white;
    margin-bottom:30px;
    border-radius:16px;
    padding:35px;
    box-shadow:0 6px 18px rgba(0,0,0,.08);
}

.section h3{
    color:#0a8a43;
    margin-bottom:18px;
}

.parts{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:15px;
}

.parts div{
    background:#f1f1f1;
    padding:14px;
    border-radius:10px;
}

.button{
    display:inline-block;
    margin-top:18px;
    padding:14px 24px;
    background:#0a8a43;
    color:white;
    text-decoration:none;
    border-radius:10px;
    font-weight:600;
}

.button:hover{
    background:#087538;
}

.video{
    position:relative;
    overflow:hidden;
    width:100%;
    padding-top:56.25%;
    border-radius:16px;
}

.video iframe{
    position:absolute;
    top:0;
    left:0;
    width:100%;
    height:100%;
    border:none;
}

table{
    width:100%;
    border-collapse:collapse;
    margin-top:20px;
}

table th{
    background:#0a8a43;
    color:white;
}

table th,
table td{
    padding:15px;
    border:1px solid #ddd;
    text-align:left;
}

.warning{
    background:#fff6d8;
    border-left:6px solid orange;
    padding:18px;
    border-radius:10px;
}

.success{
    background:#e7ffe9;
    border-left:6px solid green;
    padding:18px;
    border-radius:10px;
}

@media(max-width:850px){

header{
    justify-content:center;
    gap:20px;
}

.hero h2{
    font-size:34px;
}

.banner h2{
    font-size:28px;
}

nav{
    justify-content:center;
}

}
